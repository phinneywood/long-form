{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://wuikfmmwvrzpaoevtskn.supabase.co/functions/v1/oauth/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://wuikfmmwvrzpaoevtskn.supabase.co/functions/v1/oauth/oauth-authorization-server"
    },
    {
      "source": "/oauth/authorize",
      "destination": "/api/oauth/authorize"
    },
    {
      "source": "/oauth/request-code",
      "destination": "/api/oauth/request-code"
    },
    {
      "source": "/oauth/verify-code",
      "destination": "/api/oauth/verify-code"
    },
    {
      "source": "/oauth/token",
      "destination": "https://wuikfmmwvrzpaoevtskn.supabase.co/functions/v1/oauth/token"
    },
    {
      "source": "/oauth/test-client.json",
      "destination": "https://wuikfmmwvrzpaoevtskn.supabase.co/functions/v1/oauth/test-client.json"
    },
    {
      "source": "/oauth/test-callback",
      "destination": "/api/oauth/test-callback"
    },
    {
      "source": "/api/mcp",
      "destination": "https://wuikfmmwvrzpaoevtskn.supabase.co/functions/v1/mcp"
    },
    {
      "source": "/oauth/reviewer-login",
      "destination": "/api/oauth/reviewer-login"
    }
  ]
}
